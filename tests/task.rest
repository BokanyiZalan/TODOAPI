@Host = http://localhost
@Port = 3000

@Server={{Host}}:{{Port}}

### Get all tasks
GET {{Server}}/api/tasks
Content-Type: application/json

### Get task by ID
GET {{Server}}/api/tasks/1
Content-Type: application/json

### Create task
POST {{Server}}/api/tasks
Content-Type: application/json

{
    "title": "New Task",
    "description": "This is a new task",
    "deadline": "2024-06-30"
}

### Update task

PATCH {{Server}}/api/tasks/3
Content-Type: application/json

{
    "title": "half life 3",
    "description": "play half life 3 when it comes out",
    "deadline": "2024-07-15",
    "completed": true
}

### Delete task
DELETE {{Server}}/api/tasks/1
Content-Type: application/json

### Delete all tasks
DELETE {{Server}}/api/tasks
Content-Type: application/json
